set(CMAKE_SYSTEM_NAME Generic)
set(CMAKE_SYSTEM_PROCESSOR arm)
set(CMAKE_TRY_COMPILE_TARGET_TYPE STATIC_LIBRARY)

find_program(BOOT_ARM_GCC NAMES arm-none-eabi-gcc REQUIRED)
get_filename_component(BOOT_ARM_BIN_DIR "${BOOT_ARM_GCC}" DIRECTORY)
find_program(BOOT_ARM_AR NAMES arm-none-eabi-ar
    HINTS "${BOOT_ARM_BIN_DIR}" REQUIRED NO_DEFAULT_PATH)
find_program(BOOT_ARM_RANLIB NAMES arm-none-eabi-ranlib
    HINTS "${BOOT_ARM_BIN_DIR}" REQUIRED NO_DEFAULT_PATH)
find_program(BOOT_ARM_OBJCOPY NAMES arm-none-eabi-objcopy
    HINTS "${BOOT_ARM_BIN_DIR}" REQUIRED NO_DEFAULT_PATH)
find_program(BOOT_ARM_SIZE NAMES arm-none-eabi-size
    HINTS "${BOOT_ARM_BIN_DIR}" REQUIRED NO_DEFAULT_PATH)

set(CMAKE_C_COMPILER "${BOOT_ARM_GCC}" CACHE FILEPATH "ARM C compiler")
set(CMAKE_ASM_COMPILER "${BOOT_ARM_GCC}" CACHE FILEPATH "ARM assembler")
set(CMAKE_AR "${BOOT_ARM_AR}" CACHE FILEPATH "ARM archiver")
set(CMAKE_RANLIB "${BOOT_ARM_RANLIB}" CACHE FILEPATH "ARM ranlib")
set(CMAKE_OBJCOPY "${BOOT_ARM_OBJCOPY}" CACHE FILEPATH "ARM objcopy")
set(CMAKE_SIZE "${BOOT_ARM_SIZE}" CACHE FILEPATH "ARM size")
set(CMAKE_EXECUTABLE_SUFFIX ".elf")